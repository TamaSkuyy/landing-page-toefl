# .env untuk production VPS (nginx + PHP-FPM + MySQL lokal).
#
#   cp deploy/env.production.example .env
#   php artisan key:generate
#   # lalu isi APP_URL, DB_PASSWORD (lihat /root/pbm-credentials.txt), WHATSAPP_NUMBER
#
# Berkas ini TIDAK ikut ter-commit (.env ada di .gitignore).
# Ganti toefl.domainmu.com dengan subdomain Anda.

APP_NAME="TOEFL ITP Full Bright Indonesia"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://toefl.domainmu.com
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# Log harian; rotation otomatis oleh Laravel (LOG_DAILY_DAYS).
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=landing_page_toefl
DB_USERNAME=toefl_app
DB_PASSWORD=isi-dari-/root/pbm-credentials.txt

# Sesi & cache di database supaya tidak bergantung pada berkas.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
CACHE_STORE=database
QUEUE_CONNECTION=sync

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@domainmu.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# URL aset relatif terhadap root — WAJIB dibiarkan "/" karena HTML landing di-cache 7 hari.
ASSET_URL=/

# ===== PROJECT =====
CLIENT_ID=fullbright-toefl
PROJECT_MODE=ctwa

# ===== ANALYTICS =====
ANALYTICS_ENABLED=true
ANALYTICS_ENGAGEMENT_THRESHOLD=15
ANALYTICS_HEARTBEAT_INTERVAL=30
ANALYTICS_SESSION_TIMEOUT=30
ANALYTICS_SCROLL_BOUNCE_THRESHOLD=25
ANALYTICS_SECTION_VIEW_ENABLED=true
ANALYTICS_MINIMUM_WINNER_VISITS=30
ANALYTICS_RETENTION_DAYS=90

# Server-side rendering Inertia tidak dipakai di VPS ini (tidak ada proses Node yang
# dijalankan terus-menerus); halaman dirender di klien dan tampilannya sama.
INERTIA_SSR_ENABLED=false

# Aktifkan HANYA kalau situs di belakang proxy/CDN (mis. Cloudflare proxy aktif).
# TRUSTED_PROXIES=*

# ===== CTWA =====
WHATSAPP_NUMBER=6285255499299
WHATSAPP_DEFAULT_MESSAGE="Halo Admin Full Bright Indonesia. Saya minat mau daftar kelas TOEFL. Saya mau tanya-tanya dulu."
EXTERNAL_CHECKOUT_URL=

# ===== FORM & PAYMENT =====
PAYMENT_MODE=none
EXTERNAL_PAYMENT_URL=
THANK_YOU_PATH=/terima-kasih
PRODUCT_NAME=
PRODUCT_PRICE=

# ===== DUITKU (tidak dipakai pada mode CTWA) =====
DUITKU_ENV=sandbox
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
DUITKU_EXPIRY_PERIOD=60

# ===== META (opsional; biarkan kosong kalau belum dipakai) =====
META_PIXEL_ID=
META_ACCESS_TOKEN=
META_TEST_EVENT_CODE=
META_CAPI_ENABLED=true
META_CAPI_LOG_ENABLED=false
META_GRAPH_VERSION=v23.0

# ===== GOOGLE / MICROSOFT (opsional) =====
GTM_CONTAINER_ID=
GA4_MEASUREMENT_ID=
CLARITY_PROJECT_ID=
