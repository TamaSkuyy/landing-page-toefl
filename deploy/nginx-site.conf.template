# Server block nginx untuk Laravel (landing page TOEFL ITP).
#
# Template ini dirender oleh deploy/setup-ubuntu.sh:
#   __APP_PATH__    -> /var/www/landing-page-toefl
#   __PHP_VER__     -> 8.4 (mengikuti PHP yang terpasang di VPS)
#   __SERVER_NAME__ -> subdomain (mis. toefl.domainmu.com); "www" hanya kalau WITH_WWW=1
#
# Kalau DNS belum propagasi, ganti __SERVER_NAME__ menjadi "_" supaya nginx tetap melayani
# lewat IP VPS (tanpa HTTPS).

server {
    listen 80;
    listen [::]:80;

    server_name __SERVER_NAME__;

    root __APP_PATH__/public;
    index index.php;

    charset utf-8;
    client_max_body_size 25m;

    # Jangan pernah menyajikan berkas tersembunyi (.env ada di luar docroot, ini lapisan kedua).
    location ~ /\.(?!well-known) {
        deny all;
    }

    # Aset hasil build punya nama ber-hash -> aman di-cache lama.
    location /build/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
        try_files $uri =404;
    }

    # Gambar/video landing page (nama tanpa hash) -> cache lebih pendek agar mudah diganti.
    location /assets/ {
        expires 7d;
        add_header Cache-Control "public";
        access_log off;
        try_files $uri =404;
    }

    # OPSIONAL — layani video testimoni langsung dari nginx (Range ditangani nginx, lebih cepat
    # daripada melewati PHP). URL-nya tetap /media/... sehingga tidak ada perubahan di frontend.
    # Aktifkan dengan menghapus tanda komentar, lalu: sudo nginx -t && sudo systemctl reload nginx
    #
    # location /media/ {
    #     alias __APP_PATH__/public/assets/;
    #     access_log off;
    # }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        # CATATAN: jangan menambahkan `try_files` di sini — snippets/fastcgi-php.conf
        # bawaan Ubuntu sudah memuatnya, dan nginx menolak direktif try_files ganda
        # dalam satu location ("try_files directive is duplicate").
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php__PHP_VER__-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_read_timeout 120;
    }
}
