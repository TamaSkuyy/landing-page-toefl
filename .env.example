APP_NAME="PBM Landing Page"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=daily
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pbm_landing_page
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
CACHE_STORE=database
QUEUE_CONNECTION=sync

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Root-relative asset URLs. The landing HTML is cached for 7 days, so absolute
# URLs would break as soon as the site is opened through another host or port.
ASSET_URL=/


# ===== PROJECT =====
CLIENT_ID=client-slug
PROJECT_MODE=ctwa

# ===== ANALYTICS =====
ANALYTICS_ENABLED=true
ANALYTICS_ENGAGEMENT_THRESHOLD=15
ANALYTICS_HEARTBEAT_INTERVAL=30
ANALYTICS_SESSION_TIMEOUT=30
ANALYTICS_SCROLL_BOUNCE_THRESHOLD=25
ANALYTICS_SECTION_VIEW_ENABLED=true
ANALYTICS_MINIMUM_WINNER_VISITS=30
ANALYTICS_RETENTION_DAYS=90

# ===== CTWA =====
WHATSAPP_NUMBER=628xxxxxxxxxx
WHATSAPP_DEFAULT_MESSAGE="Halo, saya tertarik dengan program ini."
EXTERNAL_CHECKOUT_URL=

# ===== FORM & PAYMENT =====
PAYMENT_MODE=none
EXTERNAL_PAYMENT_URL=
THANK_YOU_PATH=/terima-kasih
PRODUCT_NAME=
PRODUCT_PRICE=

# ===== DUITKU =====
DUITKU_ENV=sandbox
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
DUITKU_EXPIRY_PERIOD=60

# ===== META =====
META_PIXEL_ID=
META_ACCESS_TOKEN=
META_TEST_EVENT_CODE=
META_CAPI_ENABLED=true
META_CAPI_LOG_ENABLED=false
META_GRAPH_VERSION=v23.0

# ===== GOOGLE / MICROSOFT =====
GTM_CONTAINER_ID=
GA4_MEASUREMENT_ID=
CLARITY_PROJECT_ID=
