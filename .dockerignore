# Konteks build Docker / Wasmer Edge.
#
# Builder Wasmer membatasi memori (error "Build used too much memory ... Reduce what the build
# loads at once"), dan langkah yang gagal adalah COPY seluruh konteks. Berkas ini memotong apa
# yang dimuat builder tanpa mengubah isi aplikasi yang dijalankan.

# Tooling & metadata
.git
.github
node_modules
vendor
.idea
.vscode
.zed
.fleet
.phpunit.cache
.phpactor.json

# Rahasia / environment.
# CATATAN: .env.example sengaja TIDAK dikecualikan karena Dockerfile biasanya menyalinnya
# menjadi .env saat build.
.env
.env.local
.env.production
.env.backup

# State runtime: dibuat ulang oleh aplikasi. Direktori-nya sendiri tetap ikut (kosong) supaya
# struktur storage Laravel tetap ada di dalam image.
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/inertia-devtools/*
storage/pail/*

# Salinan aset sumber yang IDENTIK dengan public/assets (101 MB, 60 berkas) dan tidak dirujuk
# kode mana pun — yang disajikan aplikasi adalah public/assets. Salinan sumbernya tetap
# tersimpan di repository; mengecualikannya di sini memotong ~44% ukuran konteks build.
resources/assets

# Dokumentasi tidak dibutuhkan saat runtime
docs

# Marker dev
public/hot
public/storage
